# Local loopback development only; ignored by the production API.
LOCAL_ADMIN_ENABLED=true
# Set these securely in Vercel Production; never use NEXT_PUBLIC_ for secrets.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=<database-scoped token>
# ADMIN_EMAIL=yourvajeremyalonzo@gmail.com
# ALERT_EMAIL=yourvajeremyalonzo@gmail.com
# SITE_URL=https://coach-jeremy.vercel.app
# Generate these using pnpm admin:setup; do not store a plaintext password.
# ADMIN_PASSWORD_HASH=<generated scrypt hash>
# ADMIN_SESSION_SECRET=<generated random secret>
# Optional email delivery, not yet connected:
# RESEND_API_KEY=<server secret>
# EMAIL_FROM=Coach Jeremy <bookings@your-verified-domain>
